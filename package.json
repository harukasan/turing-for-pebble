{
  "name": "pebble-turing-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --experimental-transform-types --test lib/simulation.test.ts",
    "typecheck": "tsc --noEmit",
    "build:wasm": "sh scripts/build-wasm.sh",
    "compare:float": "node --experimental-transform-types scripts/compare-float.mjs",
    "test:optimization": "sh scripts/check-optimization.sh",
    "test:core": "sh scripts/test-core.sh",
    "build:pebble": "sh scripts/build-pebble.sh",
    "emulator": "sh scripts/emulator.sh install 3",
    "emulator:mode0": "sh scripts/emulator.sh install 0",
    "emulator:mode1": "sh scripts/emulator.sh install 1",
    "emulator:screenshot": "sh scripts/emulator.sh screenshot",
    "emulator:logs": "sh scripts/emulator.sh logs",
    "emulator:kill": "sh scripts/emulator.sh kill",
    "device": "sh scripts/emulator.sh device-install 3",
    "device:mode0": "sh scripts/emulator.sh device-install 0",
    "device:mode1": "sh scripts/emulator.sh device-install 1",
    "device:logs": "sh scripts/emulator.sh device-logs",
    "device:screenshot": "sh scripts/emulator.sh device-screenshot"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "1.0.0-beta.5",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
