import json
import os.path
import os

top = '.'
out = 'build'


def options(ctx):
    ctx.load('pebble_sdk')


def configure(ctx):
    """
    This method is used to configure your build. ctx.load(`pebble_sdk`) automatically configures
    a build for each valid platform in `targetPlatforms`. Platform-specific configuration: add your
    change after calling ctx.load('pebble_sdk') and make sure to set the correct environment first.
    Universal configuration: add your change prior to calling ctx.load('pebble_sdk').
    """
    ctx.load('pebble_sdk')


def build(ctx):
    ctx.load('pebble_sdk')

    # The SDK copies displayName into both names of the bundle. The watch
    # menu shows shortName, so pebble.shortName in package.json replaces it.
    with open(os.path.join(ctx.path.abspath(), 'package.json')) as f:
        short_name = json.load(f)['pebble'].get('shortName')
    if short_name:
        for env in [ctx.env] + list(ctx.all_envs.values()):
            if env.PROJECT_INFO:
                env.PROJECT_INFO['shortName'] = short_name

    build_worker = os.path.exists('worker_src')
    binaries = []

    cached_env = ctx.env
    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)
        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)
        # Per-target flags come after the SDK's -Os, so RD_BUILD_OPT (default
        # -O3) selects the optimization level. RD_BUILD_PROFILE=1 adds the
        # clock calibration and periodic profile log to the watchface.
        cflags = ['-DRD_MODE=' + os.environ.get('RD_BUILD_MODE', '3'), '-fstack-usage', os.environ.get('RD_BUILD_OPT', '-O3')]
        # RD_BUILD_MODEL folds the core to one model (0 Gray-Scott, 1
        # FitzHugh-Nagumo). Without it the build includes both.
        if os.environ.get('RD_BUILD_MODEL'):
            cflags.append('-DRD_MODEL=' + os.environ['RD_BUILD_MODEL'])
        # RD_BUILD_FONT selects the clock font set (0 LECO, 1 Bitham).
        if os.environ.get('RD_BUILD_FONT'):
            cflags.append('-DRD_FONT=' + os.environ['RD_BUILD_FONT'])
        # RD_BUILD_RENDER overrides the rd_row_rgb2 flags (2 interpolates).
        if os.environ.get('RD_BUILD_RENDER'):
            cflags.append('-DRD_RENDER_FLAGS=' + os.environ['RD_BUILD_RENDER'])
        # RD_BUILD_DEFINES adds space-separated defines for study builds,
        # for example RD_STARTUP_MS=20000.
        cflags += ['-D' + d for d in os.environ.get('RD_BUILD_DEFINES', '').split()]
        # RD_BUILD_LOG=1 keeps the diagnostic logs of a measurement build.
        if os.environ.get('RD_BUILD_LOG') == '1':
            cflags.append('-DRD_LOG=1')
        if os.environ.get('RD_BUILD_PROFILE') == '1':
            cflags.append('-DRD_PROFILE')
        ctx.pbl_build(source=ctx.path.ant_glob('src/c/**/*.c'), target=app_elf, bin_type='app', cflags=cflags)

        if build_worker:
            worker_elf = '{}/pebble-worker.elf'.format(ctx.env.BUILD_DIR)
            binaries.append({'platform': platform, 'app_elf': app_elf, 'worker_elf': worker_elf})
            ctx.pbl_build(source=ctx.path.ant_glob('worker_src/c/**/*.c'),
                          target=worker_elf,
                          bin_type='worker')
        else:
            binaries.append({'platform': platform, 'app_elf': app_elf})
    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(binaries=binaries,
                   js=ctx.path.ant_glob(['src/pkjs/**/*.js',
                                         'src/pkjs/**/*.json',
                                         'src/common/**/*.js']),
                   js_entry_file='src/pkjs/index.js')
